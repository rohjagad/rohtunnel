# /etc/systemd/system/rohtunnel.service
# Phase 0: this unit runs the walking skeleton (`serve`). Reload/upgrade this
# file when the storefront and admin routes land.

[Unit]
Description=RohTunnel HTTP service
Documentation=https://github.com/rohjagad/rohtunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rohtunnel
Group=rohtunnel
WorkingDirectory=/opt/rohtunnel
EnvironmentFile=/etc/rohtunnel/env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m rohtunnel serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/rohtunnel /var/backups/rohtunnel
RuntimeDirectory=rohtunnel
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
