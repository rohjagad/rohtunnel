# /etc/systemd/system/fn-webstore.service
# Phase 0: this unit runs the walking skeleton (`serve`). Reload/upgrade this
# file when the storefront and admin routes land.

[Unit]
Description=fn-webstore HTTP service
Documentation=https://github.com/rohjagad/fn-webstore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fnwebstore
Group=fnwebstore
WorkingDirectory=/opt/fn-webstore
EnvironmentFile=/etc/fn-webstore/env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m fn_webstore serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/fn-webstore /var/backups/fn-webstore
RuntimeDirectory=fn-webstore
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
