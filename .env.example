# Copy to /etc/rohtunnel/env (mode 0600) and edit.
# Never commit the real file.

# --- application ---------------------------------------------------------
ROHTUNNEL_ENV=production
ROHTUNNEL_BASE_URL=https://store.example.com
ROHTUNNEL_BIND=127.0.0.1
ROHTUNNEL_PORT=8088
ROHTUNNEL_DB=/var/lib/rohtunnel/rohtunnel.sqlite3
ROHTUNNEL_LOG_LEVEL=INFO
ROHTUNNEL_TIMEZONE=Asia/Jakarta

# --- panel API -----------------------------------------------------------
# Same host: http://127.0.0.1:9000 (the API service).
# Remote panel: https://vpn.example.com/api (nginx /api/ location).
ROHTUNNEL_PANEL_BASE_URL=http://127.0.0.1:9000
ROHTUNNEL_PANEL_TOKEN_FILE=/etc/rohtunnel/panel-token
ROHTUNNEL_PANEL_TIMEOUT=200

# --- payments ------------------------------------------------------------
# manual = show instructions and let an admin mark the order paid.
# tripay = automatic QRIS / e-wallet / VA through Tripay.
ROHTUNNEL_PAYMENT_PROVIDER=manual
ROHTUNNEL_TRIPAY_API_KEY=
ROHTUNNEL_TRIPAY_PRIVATE_KEY=
ROHTUNNEL_TRIPAY_MERCHANT_CODE=
ROHTUNNEL_PAYMENT_EXPIRY_MINUTES=30

# --- notifications -------------------------------------------------------
ROHTUNNEL_SMTP_HOST=
ROHTUNNEL_SMTP_PORT=587
ROHTUNNEL_SMTP_USER=
ROHTUNNEL_SMTP_PASSWORD=
ROHTUNNEL_SMTP_FROM=store@example.com
ROHTUNNEL_TELEGRAM_BOT_TOKEN=
ROHTUNNEL_TELEGRAM_ADMIN_CHAT_ID=
ROHTUNNEL_ADMIN_ALERT_EMAIL=

# --- security ------------------------------------------------------------
# A 32-byte random value, base64 or hex. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ROHTUNNEL_SECRET_KEY=
# Optional: restrict /admin by source address in nginx, not only here.
ROHTUNNEL_ADMIN_ALLOWED_IPS=
