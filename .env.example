# Copy to /etc/fn-webstore/env (mode 0600) and edit.
# Never commit the real file.

# --- application ---------------------------------------------------------
FN_WEBSTORE_ENV=production
FN_WEBSTORE_BASE_URL=https://store.example.com
FN_WEBSTORE_BIND=127.0.0.1
FN_WEBSTORE_PORT=8088
FN_WEBSTORE_DB=/var/lib/fn-webstore/webstore.sqlite3
FN_WEBSTORE_LOG_LEVEL=INFO
FN_WEBSTORE_TIMEZONE=Asia/Jakarta

# --- panel API -----------------------------------------------------------
# Same host: http://127.0.0.1:9000 (the API service).
# Remote panel: https://vpn.example.com/api (nginx /api/ location).
FN_PANEL_BASE_URL=http://127.0.0.1:9000
FN_PANEL_TOKEN_FILE=/etc/fn-webstore/panel-token
FN_PANEL_TIMEOUT=200

# --- payments ------------------------------------------------------------
# manual = show instructions and let an admin mark the order paid.
# tripay = automatic QRIS / e-wallet / VA through Tripay.
FN_PAYMENT_PROVIDER=manual
FN_TRIPAY_API_KEY=
FN_TRIPAY_PRIVATE_KEY=
FN_TRIPAY_MERCHANT_CODE=
FN_PAYMENT_EXPIRY_MINUTES=30

# --- notifications -------------------------------------------------------
FN_SMTP_HOST=
FN_SMTP_PORT=587
FN_SMTP_USER=
FN_SMTP_PASSWORD=
FN_SMTP_FROM=store@example.com
FN_TELEGRAM_BOT_TOKEN=
FN_TELEGRAM_ADMIN_CHAT_ID=
FN_ADMIN_ALERT_EMAIL=

# --- security ------------------------------------------------------------
# A 32-byte random value, base64 or hex. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
FN_WEBSTORE_SECRET_KEY=
# Optional: restrict /admin by source address in nginx, not only here.
FN_ADMIN_ALLOWED_IPS=
